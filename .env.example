# Copy to .env (repository root or backend/) and adjust. Real values never go in this file.
# Everything else (networks, integrations, credentials, Telegram, agents) is configured in the UI.

# Where the server listens. 127.0.0.1 keeps it on this machine; use 0.0.0.0 (or a LAN address)
# only behind a firewall. The dashboard needs a login (first sign-in: admin / admin, you must change it).
BANANA_HOST=127.0.0.1
BANANA_PORT=8000
# Comma-separated Host names/IPs the dashboard answers to (empty: any). Set it when BANANA_HOST is not loopback.
# BANANA_ALLOWED_HOSTS=banana.lan,192.168.1.10
# Interactive API docs at /docs (off by default).
# BANANA_ENABLE_API_DOCS=false
BANANA_LOG_LEVEL=INFO
BANANA_LOG_JSON=false
BANANA_DATA_DIR=data
BANANA_FRONTEND_DIST_DIR=../frontend/dist

# Set exactly one of these. If neither is set, a key is generated on first run
# and a warning is logged - losing it makes stored credentials unrecoverable.
# Keep the key outside backups of the data directory.
# BANANA_MASTER_KEY=
# BANANA_MASTER_KEY_FILE=

# Initial defaults for the chat assistant and AI agents, used once when the database is created.
# Afterwards they are edited in the UI (AI Mode > Agents, chat panel settings).
BANANA_OLLAMA_BASE_URL=http://localhost:11434/v1
BANANA_OLLAMA_MODEL=qwen3:8b

# Optional: nmap OS detection needs root or CAP_NET_RAW, so it is off by default.
# BANANA_NMAP_OS_DETECTION_ENABLED=false

# HTTPS is on by default (via `uv run banana` / `python -m app.main`). With no certificate override,
# a self-signed EC certificate is generated on first run under BANANA_CERT_DIR and reused.
# BANANA_HTTPS_ENABLED=false
# BANANA_CERT_DIR=certificates
# BANANA_SSL_CERTFILE=
# BANANA_SSL_KEYFILE=
